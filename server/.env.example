# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed.

# Postgres connection string for the local docker-compose Postgres instance
# (see docker-compose.yml at the repo root). Port 5435 is used because
# 5432/5433/5434 are already taken by other local projects on this machine —
# adjust if your setup differs.
DATABASE_URL=postgresql://mason_connect:mason_connect_dev@localhost:5435/mason_connect

# Resend API key, used to send password-reset emails. Get one at
# https://resend.com/api-keys. Safe to leave unset in local dev if you are
# not testing real email delivery — the server itself starts up fine either
# way (the Resend client is created lazily, only when an email is actually
# sent). Without a key, sending fails when requestPasswordReset is called;
# that failure is logged server-side ([auth] falha ao enviar e-mail...) but
# the HTTP response to the client is unaffected (fire-and-forget, by
# design — see auth.ts).
RESEND_API_KEY=re_your_resend_api_key_here

# Better Auth session/cookie signing secret. Must be at least 32 characters
# of high entropy. Generate one with `openssl rand -base64 32` or
# `npx @better-auth/cli@latest secret`.
BETTER_AUTH_SECRET=replace_with_a_generated_32plus_char_secret

# Base URL of THIS server (not the frontend). Better Auth uses this to build
# absolute links (e.g. in password-reset emails).
BETTER_AUTH_URL=http://localhost:8787

# Origin of the frontend app allowed to call this API with credentials
# (cookies). Must exactly match the frontend's origin.
CORS_ORIGIN=http://localhost:5173

# Port this Express server listens on.
PORT=8787

# Standard Node environment flag. Better Auth uses `NODE_ENV === 'production'`
# to decide some safety defaults (e.g. rejecting a missing/weak `secret`,
# enabling sign-in rate limiting) — this project sets `secret` and
# `rateLimit` explicitly in auth.ts so it doesn't depend on that, but this
# var still matters for other tooling. Not read from `.env` in production:
# use `NODE_ENV=development` here for local dev, and run the built server in
# production via `npm run start -w server`, whose script already sets
# `NODE_ENV=production` itself.
NODE_ENV=development
