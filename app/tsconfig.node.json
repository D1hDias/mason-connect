{
  "compilerOptions": {
    "composite": true,
    // Composite projects can't set noEmit (TS6310), so redirect the
    // declaration/buildinfo output here instead of next to the source —
    // otherwise `tsc -b` emits a `vite.config.js` right beside
    // `vite.config.ts`, and Vite's config loader picks the stale compiled
    // .js over the real .ts on the next `dev`/`build` run.
    "outDir": "./node_modules/.tsc-out",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "tailwind.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "scripts/generate-icons.mjs"
  ]
}
